# Copy to backend/.env and set a unique JWT secret before starting the API.
# Keep this local file out of Git. Gemini credentials belong on the server.
# The Gemini key will be needed when the audio route is restored.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
DATABASE_URL="sqlite:///./database.db"
JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
